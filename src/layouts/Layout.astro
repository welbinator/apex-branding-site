---
export interface Props { title?: string; description?: string; }
const {
  title = "Apex Branding & Design — Fast, honest websites for small business",
  description = "We build fast, honest, precision websites for small businesses tired of bloated WordPress. No gradients. No fluff. See what's wrong with your current site — free."
} = Astro.props;
const isStaging = import.meta.env.BASE_URL.replace(/\/$/, '') !== '';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {isStaging && <meta name="robots" content="noindex, nofollow" />}
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' fill='%230e1116'/%3E%3Crect x='11' y='11' width='10' height='10' fill='%231a4fff'/%3E%3C/svg%3E" />
</head>
<body>
  <slot />
</body>
</html>
<style is:global>
  *{box-sizing:border-box;margin:0;padding:0}
  :root{
    --ink:#0e1116; --paper:#ffffff; --soft:#f7f8fa; --mute:#5b6472;
    --line:#e6e8ec; --accent:#1a4fff;
    --good:#16a34a; --bad:#dc2626; --warn:#d97706;
    --font-display:"Space Grotesk",-apple-system,BlinkMacSystemFont,sans-serif;
    --font-body:"Inter",-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif;
  }
  html{scroll-behavior:smooth}
  body{font-family:var(--font-body);color:var(--ink);background:var(--paper);line-height:1.5;-webkit-font-smoothing:antialiased}
  h1,h2,h3,.mark{font-family:var(--font-display);letter-spacing:-.03em}
  a{color:inherit}
  .wrap{max-width:1120px;margin:0 auto;padding:0 24px}
  /* scroll-reveal, fail-open */
  .rise{transition:opacity .6s ease, transform .6s ease}
  html.js .rise{opacity:0;transform:translateY(16px)}
  html.js .rise.in{opacity:1;transform:none}
  @media (prefers-reduced-motion: reduce){html.js .rise,.rise{opacity:1;transform:none;transition:none}}
</style>
