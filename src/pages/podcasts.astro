---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Podcast appearances. Add a new object here for each new show.
// logo = path under /public (omit or leave '' to fall back to a text badge).
const episodes = [
  {
    show: 'WP Builds',
    logo: '/img/podcasts/wp-builds.png',
    title: 'James Welbes on AI, WordPress, and new opportunities',
    episode: 'Episode 466',
    date: 'April 30, 2026',
    host: 'with Nathan Wrigley',
    blurb: "A wide-ranging conversation about how AI shifted from curiosity to everyday companion. Building apps and plugins, replacing SaaS tools with custom ones, the strange psychology of working with bots, and whether WordPress needs to reinvent itself to stay relevant.",
    url: 'https://wpbuilds.com/2026/04/30/466-james-welbes-on-ai-wordpress-and-new-opportunities/',
  },
  {
    show: 'WP Plugins A to Z',
    logo: '/img/podcasts/wp-plugins-a-to-z.png',
    title: 'Etching a New Path: Ditching WordPress Kool-Aid and Elevating Brands',
    episode: 'Interview 76',
    date: 'October 2025',
    host: 'with John Overall',
    blurb: "The story behind trading the traditional WordPress workflow for an Etch license, nearly jumping ship to Statamic, and building Apex Branding from humble Cedar Rapids beginnings. Plus branding tips for the WordPress community and why strategy matters from day one.",
    url: 'https://wppluginsatoz.com/etching-a-new-path-james-welbes-on-ditching-wordpress-kool-aid-and-elevating-brands-interview-76/',
  },
];
---
<Layout
  title="Podcast Appearances | James Welbes"
  description="Podcast appearances by James Welbes on AI, WordPress, web development, and the future of building for the web.">
  <header>
    <div class="wrap nav">
      <a class="mark" href={base + '/'}>JAMES<span class="mk-thin">WELBES</span></a>
      <a href={base + '/'} class="btn">Home</a>
    </div>
  </header>

  <section class="pod-hero">
    <div class="wrap">
      <div class="eyebrow rise">On the mic</div>
      <h1 class="rise">Podcast appearances</h1>
      <p class="lead rise">Conversations about AI, WordPress, and where building for the web is headed. Here's where I've been a guest.</p>
    </div>
  </section>

  <section class="pod-grid-wrap">
    <div class="wrap">
      <div class="pod-grid">
        {episodes.map((ep) => (
          <a class="pod-card rise" href={ep.url} target="_blank" rel="noopener">
            <div class="pod-logo">
              {ep.logo
                ? <img src={base + ep.logo} alt={ep.show + ' logo'} loading="lazy" decoding="async" />
                : <span class="pod-logo-text">{ep.show}</span>}
            </div>
            <div class="pod-body">
              <div class="pod-meta">
                <span class="pod-show">{ep.show}</span>
                {ep.episode && <span class="pod-ep">{ep.episode}</span>}
              </div>
              <h2 class="pod-title">{ep.title}</h2>
              <p class="pod-blurb">{ep.blurb}</p>
              <div class="pod-foot">
                <span>{ep.date}{ep.host ? ' · ' + ep.host : ''}</span>
                <span class="pod-listen">Listen →</span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <footer>
    <div class="wrap ffx">
      <div><strong>James Welbes</strong> · Human + AI, in that order</div>
      <div>Cedar Rapids, Iowa · Built fast, on purpose.</div>
    </div>
  </footer>

  <style>
    .pod-hero{padding:96px 0 32px}
    .pod-hero .eyebrow{display:inline-block;font-family:var(--font-display);font-size:.8rem;letter-spacing:.12em;text-transform:uppercase;color:var(--accent);font-weight:600;margin-bottom:14px}
    .pod-hero h1{font-size:clamp(2.4rem,6vw,4rem);line-height:1.02;margin-bottom:18px}
    .pod-hero .lead{font-size:1.15rem;color:var(--mute);max-width:60ch}

    .pod-grid-wrap{padding:24px 0 96px}
    .pod-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(320px,1fr));gap:24px}

    .pod-card{display:flex;flex-direction:column;background:var(--paper);border:1px solid var(--line);border-radius:16px;overflow:hidden;text-decoration:none;color:inherit;transition:transform .18s ease,box-shadow .18s ease,border-color .18s ease}
    .pod-card:hover{transform:translateY(-4px);box-shadow:0 18px 40px rgba(14,17,22,.10);border-color:color-mix(in srgb,var(--accent) 40%,var(--line))}

    .pod-logo{display:flex;align-items:center;justify-content:center;height:120px;padding:24px;background:var(--soft);border-bottom:1px solid var(--line)}
    .pod-logo img{max-height:64px;max-width:80%;width:auto;object-fit:contain}
    .pod-logo-text{font-family:var(--font-display);font-weight:700;font-size:1.4rem;letter-spacing:-.02em;color:var(--ink)}

    .pod-body{display:flex;flex-direction:column;gap:10px;padding:22px 22px 20px;flex:1}
    .pod-meta{display:flex;align-items:center;gap:10px;flex-wrap:wrap}
    .pod-show{font-family:var(--font-display);font-weight:600;font-size:.82rem;letter-spacing:.04em;text-transform:uppercase;color:var(--accent)}
    .pod-ep{font-size:.78rem;color:var(--mute);background:var(--soft);border:1px solid var(--line);padding:2px 8px;border-radius:999px}
    .pod-title{font-size:1.18rem;line-height:1.25;margin:0}
    .pod-blurb{font-size:.95rem;color:var(--mute);line-height:1.55;margin:0}
    .pod-foot{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-top:auto;padding-top:8px;font-size:.85rem;color:var(--mute)}
    .pod-listen{font-family:var(--font-display);font-weight:600;color:var(--accent);white-space:nowrap}

    footer{border-top:1px solid var(--line);padding:32px 0;margin-top:0}
    footer .ffx{display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap;color:var(--mute);font-size:.9rem}

    @media (max-width:560px){
      .pod-hero{padding:80px 0 24px}
      .pod-grid{grid-template-columns:1fr}
    }
  </style>

  <script>
    document.documentElement.classList.add("js");
    const risers = [...document.querySelectorAll(".rise")];
    const io = new IntersectionObserver(es => es.forEach(e => { if (e.isIntersecting) { e.target.classList.add("in"); io.unobserve(e.target); } }), { rootMargin: "0px 0px -8% 0px", threshold: 0.08 });
    risers.forEach(el => io.observe(el));
    setTimeout(() => risers.forEach(el => el.classList.add("in")), 2500);
  </script>
</Layout>
