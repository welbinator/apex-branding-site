---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Layout>
  <header>
    <div class="wrap nav">
      <a class="mark" href={base + '/'}><span class="dot"></span>APEX</a>
      <nav>
        <a href="#process">Process</a>
        <a href="#escape">Escape WP</a>
        <a href="#audit" class="btn">Free audit</a>
      </nav>
    </div>
  </header>

  <!-- HERO: tool-first -->
  <section class="hero">
    <div class="wrap">
      <div class="eyebrow">Free · No signup · Results in seconds</div>
      <h1>Is your website quietly costing you customers?</h1>
      <p class="lead">Paste your URL. We'll run a real performance check and show you exactly what's slow, broken, or invisible to Google — honestly, and for free.</p>
      <form class="tool" id="auditForm">
        <input id="url" type="text" inputmode="url" autocomplete="off" placeholder="yourbusiness.com" aria-label="Your website URL" />
        <button type="submit" id="auditBtn">Audit my site</button>
      </form>
      <div class="hint" id="hint">No email required. We just want you to see the truth.</div>

      <div id="report" class="report" hidden>
        <div class="rhead">
          <span class="rurl" id="rurl"></span>
          <span class="score" id="score"></span>
        </div>
        <div id="cats" class="cats"></div>
        <div id="vitals" class="vitals-wrap"></div>
        <div id="field" class="field-wrap"></div>
        <div id="opps" class="opps-wrap"></div>
        <div id="rows"></div>
        <div class="cta-card">
          <h3>Want it fixed?</h3>
          <p>We rebuild sites like this in days — fast, secure, mobile-first. Book a free 15-minute call.</p>
          <a href="#escape" class="btn-accent">Book my call →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- METRICS -->
  <div class="wrap">
    <div class="metrics rise">
      <div class="metric"><div class="n">0.4s</div><div class="l">Average load time we ship</div></div>
      <div class="metric"><div class="n">100</div><div class="l">Lighthouse performance target</div></div>
      <div class="metric"><div class="n">24</div><div class="l">Small businesses live &amp; managed</div></div>
    </div>
  </div>

  <!-- PROCESS -->
  <section id="process">
    <div class="wrap">
      <div class="k rise">How we work</div>
      <h2 class="rise">A studio that runs like a system, not a freelancer.</h2>
      <div class="grid3">
        <div class="cell rise"><div class="num">01</div><h3>Honest audit first</h3><p>We show you exactly what's slow, broken, or invisible to Google — before you pay a dollar.</p></div>
        <div class="cell rise"><div class="num">02</div><h3>Built on flat-file</h3><p>Astro &amp; Statamic, not WordPress. Nothing to hack, nothing to patch, nothing to slow it down.</p></div>
        <div class="cell rise"><div class="num">03</div><h3>Your own command center</h3><p>Every client gets a private dashboard: staging preview, request pipeline, approval loop. Organized from day one.</p></div>
      </div>
    </div>
  </section>

  <!-- MANIFESTO / ESCAPE -->
  <div class="band" id="escape">
    <div class="wrap">
      <div class="k rise" style="color:#8fa4ff">Escape from WordPress</div>
      <h2 class="rise band-h">Your website isn't a brochure. It's the first employee a customer ever meets.</h2>
      <p class="lead rise">If it's slow, confusing, or invisible to Google, you're losing business every day and never seeing the receipt. Still on WordPress? We migrate you off for good — no more plugins, patches, or 2 a.m. hacks.</p>
      <a href="#audit" class="btn-accent rise">Show me what's wrong with mine →</a>
    </div>
  </div>

  <footer>
    <div class="wrap ffx">
      <div><strong>APEX</strong> · Branding &amp; Design</div>
      <div>apexbranding.design · Built fast, on purpose.</div>
    </div>
  </footer>
</Layout>

<style is:global>
  header{border-bottom:1px solid var(--line);position:sticky;top:0;background:rgba(255,255,255,.9);backdrop-filter:blur(8px);z-index:20}
  .nav{display:flex;align-items:center;justify-content:space-between;height:66px}
  .mark{display:flex;align-items:center;gap:9px;font-weight:700;font-size:19px;text-decoration:none}
  .mark .dot{width:11px;height:11px;background:var(--accent)}
  nav a{text-decoration:none;font-size:14px;font-weight:500;margin-left:26px;opacity:.75}
  nav a:hover{opacity:1}
  .btn{background:var(--ink);color:#fff!important;padding:9px 17px;border-radius:2px;opacity:1!important;font-weight:600}
  .btn:hover{background:var(--accent)}

  .hero{padding:82px 0 20px;text-align:center}
  .eyebrow{font-size:12px;font-weight:700;letter-spacing:.13em;text-transform:uppercase;color:var(--accent)}
  h1{font-size:54px;line-height:1.04;font-weight:700;margin:18px auto 18px;max-width:720px}
  .lead{font-size:19px;color:var(--mute);max-width:600px;margin:0 auto 32px}
  .tool{display:flex;gap:8px;max-width:540px;margin:0 auto;background:#fff;border:1px solid var(--line);border-radius:6px;padding:7px;box-shadow:0 14px 44px rgba(14,17,22,.07)}
  .tool input{flex:1;border:none;outline:none;font-size:16px;padding:13px;background:transparent;color:var(--ink);font-family:var(--font-body)}
  .tool button{background:var(--ink);color:#fff;border:none;font-weight:600;font-size:15px;padding:0 22px;border-radius:4px;cursor:pointer;white-space:nowrap;font-family:var(--font-body)}
  .tool button:hover{background:var(--accent)}
  .tool button:disabled{opacity:.6;cursor:wait}
  .hint{font-size:13px;color:var(--mute);margin-top:13px}
  .hint.err{color:var(--bad)}

  .report{max-width:620px;margin:34px auto 0;text-align:left}
  .rhead{display:flex;align-items:center;justify-content:space-between;margin-bottom:13px;flex-wrap:wrap;gap:6px}
  .rurl{font-weight:600;font-size:15px}
  .score{font-size:13px;font-weight:700}
  .row{background:#fff;border:1px solid var(--line);border-radius:6px;padding:15px 17px;margin-bottom:9px;display:flex;gap:13px;align-items:flex-start}
  .icn{width:22px;height:22px;border-radius:50%;flex:0 0 auto;display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:800;color:#fff;margin-top:1px}
  .icn.bad{background:var(--bad)}.icn.warn{background:var(--warn)}.icn.good{background:var(--good)}
  .row h4{font-size:15px;margin-bottom:3px;font-family:var(--font-body);font-weight:600;letter-spacing:0}
  .row p{font-size:13.5px;color:var(--mute)}
  .cta-card{background:var(--ink);color:#fff;border-radius:6px;padding:22px;text-align:center;margin-top:16px}
  .cta-card h3{font-size:18px;margin-bottom:6px}

  /* --- deep audit sections --- */
  .cats{display:grid;grid-template-columns:1fr 1fr;gap:12px 20px;margin-bottom:22px}
  .cat-top{display:flex;justify-content:space-between;font-size:13px;font-weight:600;margin-bottom:5px}
  .cat-top b{font-size:14px}
  .bar{height:6px;background:var(--line);border-radius:3px;overflow:hidden}
  .fill{height:100%;border-radius:3px;transition:width .7s ease}
  .sec-lbl{font-size:12px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--mute);margin:18px 0 11px}
  .sec-lbl span{font-weight:500;text-transform:none;letter-spacing:0;opacity:.75}
  .vitals{display:grid;grid-template-columns:repeat(3,1fr);gap:9px}
  .vital{background:#fff;border:1px solid var(--line);border-radius:6px;padding:13px 12px;position:relative}
  .vdot{width:8px;height:8px;border-radius:50%;position:absolute;top:13px;right:12px}
  .vval{font-family:var(--font-display);font-size:20px;font-weight:700}
  .vname{font-size:12px;font-weight:600;margin-top:2px}
  .vhelp{font-size:11.5px;color:var(--mute);margin-top:3px;line-height:1.35}
  .field{display:flex;flex-wrap:wrap;gap:8px}
  .fchip{font-size:13px;background:#fff;border:1px solid var(--line);border-left-width:3px;border-radius:5px;padding:8px 12px;display:flex;align-items:center;gap:7px}
  .fchip b{font-family:var(--font-display)}
  .fdot{width:7px;height:7px;border-radius:50%;display:inline-block}
  .opp{background:#fff;border:1px solid var(--line);border-radius:6px;padding:12px 15px;margin-bottom:8px;display:flex;justify-content:space-between;align-items:center;gap:12px}
  .opp-t{font-size:14px;font-weight:500}
  .opp-s{font-size:12.5px;font-weight:700;color:var(--accent);white-space:nowrap}
  #rows{margin-top:18px}
  @media(max-width:560px){.cats{grid-template-columns:1fr}.vitals{grid-template-columns:1fr 1fr}.opp{flex-direction:column;align-items:flex-start;gap:4px}}
  .cta-card p{color:#aab2c0;font-size:14px;margin-bottom:15px}
  .btn-accent{display:inline-block;background:var(--accent);color:#fff!important;text-decoration:none;font-weight:600;font-size:14px;padding:11px 22px;border-radius:4px}
  .btn-accent:hover{filter:brightness(1.1)}

  .metrics{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid var(--line);border-bottom:1px solid var(--line);margin-top:64px}
  .metric{padding:30px 22px;border-right:1px solid var(--line)}
  .metric:last-child{border-right:none}
  .metric .n{font-family:var(--font-display);font-size:38px;font-weight:700}
  .metric .l{font-size:13px;color:var(--mute);margin-top:3px}

  section{padding:82px 0}
  .k{font-size:12px;font-weight:700;letter-spacing:.13em;text-transform:uppercase;color:var(--mute)}
  h2{font-size:36px;font-weight:700;margin:12px 0 38px;max-width:640px}
  .grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--line);border:1px solid var(--line)}
  .cell{background:#fff;padding:28px}
  .cell .num{font-size:12px;font-weight:700;color:var(--accent);margin-bottom:13px}
  .cell h3{font-size:18px;margin-bottom:9px}
  .cell p{font-size:15px;color:var(--mute)}

  .band{background:var(--ink);color:#fff;padding:82px 0}
  .band .band-h{color:#fff}
  .band .lead{color:#aab2c0}

  footer{border-top:1px solid var(--line);padding:38px 0;font-size:13px;color:var(--mute)}
  .ffx{display:flex;justify-content:space-between;flex-wrap:wrap;gap:14px}

  @media(max-width:720px){
    h1{font-size:36px}h2{font-size:28px}
    .metrics,.grid3{grid-template-columns:1fr}
    .metric{border-right:none;border-bottom:1px solid var(--line)}
    .tool{flex-direction:column}.tool button{padding:13px}
    nav a:not(.btn){display:none}
  }
</style>

<script define:vars={{ base }}>
  document.documentElement.classList.add('js');
  // scroll reveal, fail-open
  const risers = [...document.querySelectorAll('.rise')];
  const io = new IntersectionObserver((es)=>es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target);}}),{rootMargin:'0px 0px -8% 0px',threshold:0.08});
  risers.forEach(el=>io.observe(el));
  setTimeout(()=>risers.forEach(el=>el.classList.add('in')),2500);

  // audit tool
  const form=document.getElementById('auditForm');
  const input=document.getElementById('url');
  const btn=document.getElementById('auditBtn');
  const hint=document.getElementById('hint');
  const report=document.getElementById('report');
  const rows=document.getElementById('rows');

  function normalize(u){u=u.trim();if(!u)return '';if(!/^https?:\/\//i.test(u))u='https://'+u;return u;}
  function icon(k){return k==='good'?'✓':k==='warn'?'~':'!';}
  function lvlColor(k){return k==='good'?'var(--good)':k==='warn'?'var(--warn)':'var(--bad)';}

  function render(data){
    document.getElementById('rurl').textContent=data.url;
    const s=document.getElementById('score');
    s.textContent='Overall: '+data.score+' / 100';
    s.style.color=lvlColor(data.score>=80?'good':data.score>=50?'warn':'bad');

    // Category score bars
    document.getElementById('cats').innerHTML=(data.categories||[]).map(c=>{
      const v=c.score==null?'—':c.score;
      return `<div class="cat">
        <div class="cat-top"><span>${c.label}</span><b style="color:${lvlColor(c.level)}">${v}</b></div>
        <div class="bar"><div class="fill" style="width:${c.score==null?0:c.score}%;background:${lvlColor(c.level)}"></div></div>
      </div>`;
    }).join('');

    // Core Web Vitals (lab)
    const vw=document.getElementById('vitals');
    if((data.vitals||[]).length){
      vw.innerHTML=`<div class="sec-lbl">Core Web Vitals <span>(lab test)</span></div>
        <div class="vitals">`+data.vitals.map(v=>
        `<div class="vital"><div class="vdot" style="background:${lvlColor(v.level)}"></div>
          <div class="vval">${v.value||'—'}</div>
          <div class="vname">${v.name}</div>
          <div class="vhelp">${v.help}</div></div>`).join('')+`</div>`;
    } else vw.innerHTML='';

    // Real-user field data
    const fw=document.getElementById('field');
    if(data.hasField && (data.field||[]).length){
      fw.innerHTML=`<div class="sec-lbl">Real visitor experience <span>(Chrome user data, last 28 days)</span></div>
        <div class="field">`+data.field.map(f=>
        `<div class="fchip" style="border-color:${lvlColor(f.level)}">
          <span class="fdot" style="background:${lvlColor(f.level)}"></span>${f.name}: <b>${f.value}</b></div>`).join('')+`</div>`;
    } else fw.innerHTML='';

    // Fix opportunities
    const ow=document.getElementById('opps');
    if((data.opportunities||[]).length){
      ow.innerHTML=`<div class="sec-lbl">Biggest fixes available <span>(estimated gains)</span></div>`+
        data.opportunities.map(o=>
        `<div class="opp"><div class="opp-t">${o.title}</div><div class="opp-s">${o.savings}</div></div>`).join('');
    } else ow.innerHTML='';

    // Pass/fail findings
    document.getElementById('rows').innerHTML=(data.findings||[]).map(f=>
      `<div class="row"><div class="icn ${f.level}">${icon(f.level)}</div><div><h4>${f.title}</h4><p>${f.detail}</p></div></div>`
    ).join('');

    report.hidden=false;
    report.scrollIntoView({behavior:'smooth',block:'start'});
  }

  form.addEventListener('submit', async (e)=>{
    e.preventDefault();
    const url=normalize(input.value);
    if(!url){hint.textContent='Enter a website address first.';hint.classList.add('err');return;}
    hint.classList.remove('err');
    btn.disabled=true;const orig=btn.textContent;btn.textContent='Analyzing…';
    hint.textContent='Running a real performance check — this takes 10-20 seconds…';
    try{
      const res=await fetch(`${base}/api/audit?url=`+encodeURIComponent(url));
      if(!res.ok) throw new Error('bad status '+res.status);
      const data=await res.json();
      if(data.error) throw new Error(data.error);
      render(data);
      hint.textContent='Analysis of a live, third-party performance report.';
    }catch(err){
      hint.textContent="Couldn't reach that site or the audit service is busy. Check the URL and try again.";
      hint.classList.add('err');
    }finally{
      btn.disabled=false;btn.textContent=orig;
    }
  });
</script>
