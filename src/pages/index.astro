---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Layout>
  <header>
    <div class="wrap nav">
      <a class="mark" href={base + '/'}>JAMES<span class="mk-thin">WELBES</span></a>
      <button class="nav-toggle" aria-label="Open menu" aria-expanded="false" aria-controls="site-nav">
        <span></span><span></span><span></span>
      </button>
      <nav id="site-nav">
        <a href="#thesis">The idea</a>
        <a href="#about">About</a>
        <a href="#work">Work</a>
        <a href={base + '/website'}>$49/mo sites</a>
        <a href="#audit" class="btn">Free audit</a>
      </nav>
    </div>
  </header>

  <!-- HERO -->
  <section class="hero">
    <div class="glow"></div>
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <div class="eyebrow rise">One human · commanding AI</div>
        <h1 class="rise">One human.<br>An army of <span class="hl">AI agents</span>.<br>Zero BS.</h1>
        <p class="lead rise">I'm James Welbes. For over a decade I've built websites and led products by hand. Now I do it with a swarm of AI working under me - the judgment of a human, the horsepower of a machine. That's a combination almost nobody offers, and it's exactly what your project needs.</p>
        <div class="hero-cta rise">
          <a href="#audit" class="btn-accent">Audit my site free →</a>
          <a href="#thesis" class="btn-ghost">Why this works</a>
        </div>
      </div>
    </div>
    <img class="hero-bg" src={base + '/img/james-900.webp'}
      srcset={`${base}/img/james-640.webp 640w, ${base}/img/james-900.webp 900w, ${base}/img/james-1256.webp 1256w`}
      sizes="(max-width: 860px) 82vw, 720px"
      width="1256" height="838" fetchpriority="high" decoding="async"
      alt="James Welbes holding a cap that reads 'I love BS - Brand Strategy'" />
  </section>

  <!-- THESIS: the AI + human argument -->
  <section id="thesis" class="thesis">
    <div class="wrap">
      <div class="k rise" style="color:#8fa4ff">The idea</div>
      <h2 class="rise th-h">Pure AI is reckless. One person is capped.<br>The magic is a human <span class="hl">in command</span> of AI.</h2>
      <div class="tri">
        <div class="tcard rise">
          <div class="tlabel bad-l">100% AI</div>
          <h3>Fast, but reckless</h3>
          <p>AI alone is confident and wrong at scale. No taste, no accountability, no idea when it's quietly breaking your business. It'll ship you garbage at lightning speed.</p>
        </div>
        <div class="tcard rise">
          <div class="tlabel warn-l">One human</div>
          <h3>Careful, but capped</h3>
          <p>A single person brings judgment and craft - but there are only so many hours in a day. Good work, slowly, and expensively. Everyone hits the same ceiling.</p>
        </div>
        <div class="tcard feature rise">
          <div class="tlabel good-l">Human + AI</div>
          <h3>Both. That's me.</h3>
          <p>I steer a fleet of AI agents that do the heavy lifting, then I apply the taste, the judgment, and the accountability a machine will never have. Speed <em>and</em> sense.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- AUDIT TOOL: reframed as proof -->
  <section id="audit" class="audit">
    <div class="wrap">
      <div class="k rise" style="color:var(--accent)">Proof, not promises</div>
      <h2 class="rise">See it work. Right now, on your own site.</h2>
      <p class="lead rise audit-lead">This is the human-plus-AI approach in miniature: my tool runs a real, deep performance analysis in seconds - then hands you a plain-English read on what's actually costing you customers. No signup. No spin.</p>
      <form class="tool rise" id="auditForm">
        <input id="url" type="text" inputmode="url" autocomplete="off" placeholder="yourbusiness.com" aria-label="Your website URL" />
        <button type="submit" id="auditBtn">Audit my site</button>
      </form>
      <div class="hint" id="hint">Free. No email. Just the truth about your site.</div>

      <div id="report" class="report" hidden>
        <div class="rhead">
          <span class="rurl" id="rurl"></span>
          <span class="score" id="score"></span>
        </div>
        <div id="cats" class="cats"></div>
        <div id="vitals" class="vitals-wrap"></div>
        <div id="field" class="field-wrap"></div>
        <div id="opps" class="opps-wrap"></div>
        <div id="a11y" class="a11y-wrap"></div>
        <div id="stack" class="stack-wrap"></div>
        <div id="hosting" class="hosting-wrap"></div>
        <div id="rows"></div>
        <div class="cta-card">
          <h3>Want it fixed - properly?</h3>
          <p>This is the easy part. I rebuild sites like yours fast, secure, and mobile-first - then hand you something that actually earns its keep. Let's talk.</p>
          <a href={base + '/website'} class="btn-accent">Get a site for $49/mo →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ABOUT -->
  <section id="about" class="about">
    <div class="wrap about-grid">
      <div class="about-photo rise">
        <img src={base + '/img/james2-600.webp'}
          srcset={`${base}/img/james2-600.webp 600w, ${base}/img/james2.webp 1000w`}
          sizes="(max-width: 860px) 82vw, 460px"
          width="1000" height="1250" loading="lazy" decoding="async" alt="James Welbes at sunset over the water, cigar in hand" />
      </div>
      <div class="rise">
        <div class="k" style="color:#8fa4ff">Who's actually in charge</div>
        <h2 class="about-h">A decade of doing this by hand - now amplified.</h2>
        <p class="about-p">I've worn every hat in this business: agency owner, developer, product owner, and yes, the video-tutorial guy. As former Product Owner at StellarWP (Liquid Web), I owned roadmaps and shipped real software used by thousands of sites.</p>
        <p class="about-p">That experience is the part AI can't fake. I know what "done right" looks like, I know where projects quietly rot, and I know when the machine is confidently wrong. So I let AI do what it's great at - volume, speed, tireless iteration - and I stay the human who's accountable for the result.</p>
        <ul class="creds">
          <li><b>10+ years</b> in the web &amp; WordPress ecosystem</li>
          <li><b>Ex-Product Owner</b>, StellarWP / Liquid Web</li>
          <li><b>Agency owner</b> since 2015 · Cedar Rapids, Iowa</li>
          <li><b>Real software shipped</b> - plugins, MVPs, products in market</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- WORK -->
  <section id="work" class="work">
    <div class="wrap">
      <div class="k rise">A few things I've built</div>
      <h2 class="rise">Real software. Real sites. Shipped.</h2>
      <div class="grid3">
        <div class="cell rise"><div class="num">01</div><h3>YouTube for WordPress</h3><p>A plugin that imports and displays videos from a YouTube channel - built, shipped, and in real use.</p></div>
        <div class="cell rise"><div class="num">02</div><h3>CloneWP</h3><p>Clone plugins or themes straight into your site from GitHub. A developer tool that solves a real, tedious problem.</p></div>
        <div class="cell rise"><div class="num">03</div><h3>RoadMapWP</h3><p>User-driven product roadmaps - turning customer feedback into a prioritized plan you can actually ship against.</p></div>
      </div>
    </div>
  </section>

  <!-- CLOSING BAND -->
  <div class="band" id="close">
    <div class="wrap">
      <div class="k rise" style="color:#8fa4ff">Let's build something</div>
      <h2 class="rise band-h">You don't need an agency. You don't need a chatbot.<br>You need one capable human with an army behind him.</h2>
      <p class="lead rise">Start by seeing the truth about your current site - free, in about fifteen seconds. Then we talk about what's next.</p>
      <a href="#audit" class="btn-accent rise">Audit my site →</a>
    </div>
  </div>

  <footer>
    <div class="wrap ffx">
      <div><strong>James Welbes</strong> · Human + AI, in that order</div>
      <div>Cedar Rapids, Iowa · Built fast, on purpose.</div>
    </div>
  </footer>
</Layout>

<style is:global>
  :root{ --bg:#0b0d12; --bg2:#111520; --card:#151a26; --line2:#232a3a; --txt:#eef1f6; --mut:#9aa4b6; }
  body{background:var(--bg);color:var(--txt)}
  ::selection{background:var(--accent);color:#fff}

  header{border-bottom:1px solid var(--line2);position:sticky;top:0;background:rgba(11,13,18,.82);backdrop-filter:blur(10px);z-index:30}
  .nav{display:flex;align-items:center;justify-content:space-between;height:68px}
  .mark{display:flex;align-items:center;gap:9px;font-weight:700;font-size:18px;text-decoration:none;letter-spacing:-.02em}
  .mark .mk-thin{font-weight:400;opacity:.6}
  nav a{text-decoration:none;font-size:14px;font-weight:500;margin-left:26px;color:var(--mut)}
  nav a:hover{color:var(--txt)}
  .nav-toggle{display:none;flex-direction:column;justify-content:center;gap:5px;width:42px;height:42px;padding:0 9px;background:transparent;border:1px solid var(--line2);border-radius:9px;cursor:pointer}
  .nav-toggle span{display:block;height:2px;width:100%;background:var(--txt);border-radius:2px;transition:transform .25s ease,opacity .2s ease}
  .nav-toggle[aria-expanded="true"] span:nth-child(1){transform:translateY(7px) rotate(45deg)}
  .nav-toggle[aria-expanded="true"] span:nth-child(2){opacity:0}
  .nav-toggle[aria-expanded="true"] span:nth-child(3){transform:translateY(-7px) rotate(-45deg)}
  .btn{background:#fff;color:var(--bg)!important;padding:9px 17px;border-radius:3px;font-weight:600}
  .btn:hover{background:var(--accent);color:#fff!important}

  .hl{color:var(--accent);text-shadow:0 0 34px rgba(26,79,255,.55)}

  /* HERO */
  .hero{position:relative;min-height:100vh;display:flex;align-items:center;padding:70px 0 40px;overflow:hidden}
  .glow{position:absolute;top:-120px;right:-40px;width:720px;height:720px;background:radial-gradient(circle,rgba(26,79,255,.30),transparent 62%);filter:blur(20px);pointer-events:none;z-index:0}
  .hero-bg{position:absolute;bottom:0;right:-120px;height:98%;width:auto;max-width:75%;object-fit:contain;object-position:bottom right;z-index:1;filter:drop-shadow(0 26px 70px rgba(0,0,0,.6));-webkit-mask-image:linear-gradient(to right,transparent,#000 22%);mask-image:linear-gradient(to right,transparent,#000 22%)}
  .hero-grid{position:relative;z-index:2;width:100%}
  .hero-copy{max-width:600px}
  .eyebrow{font-size:12px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;color:var(--accent)}
  h1{font-size:66px;line-height:1.02;font-weight:700;margin:16px 0 20px;letter-spacing:-.035em}
  .lead{font-size:18px;color:var(--mut);max-width:560px;line-height:1.6}
  .hero-copy .lead{margin-bottom:28px}
  .hero-cta{display:flex;gap:12px;flex-wrap:wrap}
  .btn-ghost{display:inline-block;border:1px solid var(--line2);color:var(--txt)!important;text-decoration:none;font-weight:600;font-size:14px;padding:11px 22px;border-radius:4px;background:rgba(11,13,18,.5)}
  .btn-ghost:hover{border-color:var(--accent);color:#fff!important}

  /* THESIS */
  .thesis{padding:90px 0;border-top:1px solid var(--line2)}
  .th-h{max-width:760px}
  .tri{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
  .tcard{background:var(--card);border:1px solid var(--line2);border-radius:12px;padding:26px}
  .tcard.feature{border-color:rgba(26,79,255,.6);box-shadow:0 0 0 1px rgba(26,79,255,.35),0 22px 50px rgba(26,79,255,.14);background:linear-gradient(180deg,rgba(26,79,255,.08),var(--card))}
  .tlabel{display:inline-block;font-size:11px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;padding:5px 10px;border-radius:20px;margin-bottom:16px}
  .bad-l{color:#ff9b9b;background:rgba(220,38,38,.14)}
  .warn-l{color:#f5c98a;background:rgba(217,119,6,.16)}
  .good-l{color:#8ef0b0;background:rgba(22,163,74,.16)}
  .tcard h3{font-size:20px;margin-bottom:10px}
  .tcard p{font-size:14.5px;color:var(--mut);line-height:1.6}
  .tcard em{color:var(--txt);font-style:normal;font-weight:600}

  /* AUDIT */
  .audit{padding:90px 0;border-top:1px solid var(--line2);text-align:center}
  .audit h2{margin-left:auto;margin-right:auto}
  .audit-lead{margin:0 auto 30px;text-align:center}
  .tool{display:flex;gap:8px;max-width:540px;margin:0 auto;background:var(--card);border:1px solid var(--line2);border-radius:8px;padding:8px;box-shadow:0 18px 50px rgba(0,0,0,.4)}
  .tool input{flex:1;border:none;outline:none;font-size:16px;padding:13px;background:transparent;color:var(--txt);font-family:var(--font-body)}
  .tool input::placeholder{color:#6b7385}
  .tool button{background:var(--accent);color:#fff;border:none;font-weight:600;font-size:15px;padding:0 22px;border-radius:5px;cursor:pointer;white-space:nowrap;font-family:var(--font-body)}
  .tool button:hover{filter:brightness(1.12)}
  .tool button:disabled{opacity:.85;cursor:wait}
  .tool button .spin{display:inline-block;width:15px;height:15px;border:2px solid rgba(255,255,255,.35);border-top-color:#fff;border-radius:50%;animation:spin .7s linear infinite;vertical-align:-2px;margin-right:8px}
  @keyframes spin{to{transform:rotate(360deg)}}
  .hint{font-size:13px;color:var(--mut);margin-top:14px}
  .hint.err{color:#ff9b9b}

  .report{max-width:640px;margin:36px auto 0;text-align:left}
  .rhead{display:flex;align-items:center;justify-content:space-between;margin-bottom:14px;flex-wrap:wrap;gap:6px}
  .rurl{font-weight:600;font-size:15px}
  .score{font-size:13px;font-weight:700}
  .row{background:var(--card);border:1px solid var(--line2);border-radius:8px;padding:15px 17px;margin-bottom:9px;display:flex;gap:13px;align-items:flex-start}
  .icn{width:22px;height:22px;border-radius:50%;flex:0 0 auto;display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:800;color:#fff;margin-top:1px}
  .icn.bad{background:var(--bad)}.icn.warn{background:var(--warn)}.icn.good{background:var(--good)}
  .row h4{font-size:15px;margin-bottom:3px;font-family:var(--font-body);font-weight:600;letter-spacing:0}
  .row p{font-size:13.5px;color:var(--mut)}
  .cta-card{background:linear-gradient(180deg,rgba(26,79,255,.12),var(--card));border:1px solid rgba(26,79,255,.4);color:#fff;border-radius:10px;padding:24px;text-align:center;margin-top:18px}
  .cta-card h3{font-size:19px;margin-bottom:7px}

  /* deep audit sections */
  .cats{display:grid;grid-template-columns:1fr 1fr;gap:12px 20px;margin-bottom:22px}
  .cat-top{display:flex;justify-content:space-between;font-size:13px;font-weight:600;margin-bottom:5px}
  .cat-top b{font-size:14px}
  .bar{height:6px;background:var(--line2);border-radius:3px;overflow:hidden}
  .fill{height:100%;border-radius:3px;transition:width .7s ease}
  .sec-lbl{font-size:12px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--mut);margin:18px 0 11px}
  .sec-lbl span{font-weight:500;text-transform:none;letter-spacing:0;opacity:.75}
  .vitals{display:grid;grid-template-columns:repeat(3,1fr);gap:9px}
  .vital{background:var(--card);border:1px solid var(--line2);border-radius:8px;padding:13px 12px;position:relative}
  .vdot{width:8px;height:8px;border-radius:50%;position:absolute;top:13px;right:12px}
  .vval{font-family:var(--font-display);font-size:20px;font-weight:700}
  .vname{font-size:12px;font-weight:600;margin-top:2px}
  .vhelp{font-size:11.5px;color:var(--mut);margin-top:3px;line-height:1.35}
  .field{display:flex;flex-wrap:wrap;gap:8px}
  .fchip{font-size:13px;background:var(--card);border:1px solid var(--line2);border-left-width:3px;border-radius:6px;padding:8px 12px;display:flex;align-items:center;gap:7px}
  .fchip b{font-family:var(--font-display)}
  .fdot{width:7px;height:7px;border-radius:50%;display:inline-block}
  .opp{background:var(--card);border:1px solid var(--line2);border-radius:8px;padding:12px 15px;margin-bottom:8px;display:flex;justify-content:space-between;align-items:center;gap:12px}
  .opp-t{font-size:14px;font-weight:500}
  .opp-s{font-size:12.5px;font-weight:700;color:#7da2ff;white-space:nowrap}
  .stack{display:flex;flex-wrap:wrap;gap:8px}
  .tchip{background:var(--card);border:1px solid var(--line2);border-radius:6px;padding:7px 11px;line-height:1.25}
  .tchip b{font-family:var(--font-display);font-size:13.5px;font-weight:600;display:block}
  .tchip span{font-size:11px;color:var(--mut);letter-spacing:.02em}
  .host{background:var(--card);border:1px solid var(--line2);border-radius:8px;overflow:hidden}
  .hrow{display:flex;justify-content:space-between;gap:14px;padding:9px 14px;font-size:13.5px;border-top:1px solid var(--line2)}
  .hrow:first-child{border-top:none}
  .hk{color:var(--mut)}
  .hv{font-weight:600;text-align:right;word-break:break-word}
  .a11y-wrap{margin-top:8px}
  .a11y-sum{display:flex;gap:12px;align-items:flex-start;background:var(--card);border:1px solid var(--line2);border-radius:8px;padding:13px 15px}
  .a11y-sum h4{font-family:var(--font-display);font-size:15px;margin:0 0 3px}
  .a11y-sum p{font-size:12.5px;color:var(--mut);line-height:1.5;margin:0}
  .a11y-list{margin-top:10px;display:flex;flex-direction:column;gap:8px}
  .a11y-item{display:flex;gap:10px;align-items:flex-start;background:var(--card);border:1px solid var(--line2);border-left:3px solid var(--warn,#d97706);border-radius:6px;padding:10px 13px}
  .a11y-dot{width:7px;height:7px;border-radius:50%;background:var(--warn,#d97706);margin-top:6px;flex:none}
  .a11y-item b{font-family:var(--font-display);font-size:13.5px;font-weight:600;display:block;margin-bottom:2px}
  .a11y-item span{font-size:12px;color:var(--mut);line-height:1.45}
  .a11y-n{color:var(--warn,#d97706);font-weight:600}
  #rows{margin-top:18px}
  .cta-card p{color:#c3ccdb;font-size:14px;margin-bottom:15px}
  .btn-accent{display:inline-block;background:var(--accent);color:#fff!important;text-decoration:none;font-weight:600;font-size:14px;padding:12px 24px;border-radius:5px;box-shadow:0 8px 24px rgba(26,79,255,.3)}
  .btn-accent:hover{filter:brightness(1.12)}

  /* ABOUT */
  .about{padding:90px 0;border-top:1px solid var(--line2)}
  .about-grid{display:grid;grid-template-columns:.8fr 1.2fr;gap:44px;align-items:center}
  .about-photo{border-radius:14px;overflow:hidden;border:1px solid var(--line2);box-shadow:0 24px 60px rgba(0,0,0,.5)}
  .about-photo img{width:100%;height:auto;display:block}
  .about-h{font-size:34px;margin:12px 0 20px}
  .about-p{font-size:16px;color:var(--mut);line-height:1.7;margin-bottom:16px;max-width:560px}
  .creds{list-style:none;margin-top:22px;display:grid;gap:11px}
  .creds li{font-size:15px;color:var(--mut);padding-left:22px;position:relative}
  .creds li:before{content:"→";position:absolute;left:0;color:var(--accent);font-weight:700}
  .creds b{color:var(--txt)}

  section{padding:90px 0}
  .k{font-size:12px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--mut)}
  h2{font-size:38px;font-weight:700;margin:12px 0 40px;max-width:680px;letter-spacing:-.03em;line-height:1.1}

  /* WORK */
  .work{border-top:1px solid var(--line2)}
  .grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
  .cell{background:var(--card);border:1px solid var(--line2);border-radius:12px;padding:28px;transition:border-color .2s,transform .2s}
  .cell:hover{border-color:rgba(26,79,255,.5);transform:translateY(-3px)}
  .cell .num{font-size:12px;font-weight:700;color:var(--accent);margin-bottom:14px}
  .cell h3{font-size:19px;margin-bottom:10px}
  .cell p{font-size:14.5px;color:var(--mut);line-height:1.6}

  /* BAND */
  .band{background:linear-gradient(180deg,var(--bg2),var(--bg));padding:96px 0;border-top:1px solid var(--line2);text-align:center}
  .band .k{margin-bottom:0}
  .band-h{margin-left:auto;margin-right:auto}
  .band .lead{margin:0 auto 30px;text-align:center}

  footer{border-top:1px solid var(--line2);padding:40px 0;font-size:13px;color:var(--mut)}
  .ffx{display:flex;justify-content:space-between;flex-wrap:wrap;gap:14px}
  footer strong{color:var(--txt)}

  @media(max-width:860px){
    .hero{display:block;min-height:auto;padding:56px 0 40px}
    .hero-bg{position:relative;right:auto;height:auto;width:82%;max-width:360px;margin:26px auto 0;display:block;-webkit-mask-image:none;mask-image:none}
    .hero-copy{max-width:none}
    .about-grid{grid-template-columns:1fr}
    .about-photo{max-width:340px}
    h1{font-size:46px}
  }
  @media(max-width:720px){
    h1{font-size:38px}h2{font-size:28px}.about-h{font-size:26px}
    .tri,.grid3{grid-template-columns:1fr}
    .cats{grid-template-columns:1fr}.vitals{grid-template-columns:1fr 1fr}
    .opp{flex-direction:column;align-items:flex-start;gap:4px}
    .tool{flex-direction:column}.tool button{padding:14px}
    .nav-toggle{display:flex}
    nav{display:flex;position:absolute;top:68px;left:0;right:0;flex-direction:column;align-items:stretch;gap:0;background:rgba(11,13,18,.97);backdrop-filter:blur(12px);border-bottom:1px solid var(--line2);padding:8px 0 14px;transform:translateY(-8px);opacity:0;pointer-events:none;transition:transform .22s ease,opacity .22s ease;max-height:calc(100vh - 68px);overflow-y:auto}
    nav.open{transform:translateY(0);opacity:1;pointer-events:auto}
    nav a{margin:0;padding:14px 24px;font-size:16px;border-top:1px solid var(--line2)}
    nav a.btn{margin:12px 24px 2px;text-align:center;border-top:none}
  }
</style>

<script define:vars={{ base }}>
  document.documentElement.classList.add('js');
  // mobile nav toggle
  (function(){
    const btn=document.querySelector('.nav-toggle'), menu=document.getElementById('site-nav');
    if(btn&&menu){
      const set=(o)=>{menu.classList.toggle('open',o);btn.setAttribute('aria-expanded',o?'true':'false');btn.setAttribute('aria-label',o?'Close menu':'Open menu');};
      btn.addEventListener('click',()=>set(!menu.classList.contains('open')));
      menu.querySelectorAll('a').forEach(a=>a.addEventListener('click',()=>set(false)));
      document.addEventListener('keydown',e=>{if(e.key==='Escape')set(false);});
      document.addEventListener('click',e=>{if(menu.classList.contains('open')&&!menu.contains(e.target)&&!btn.contains(e.target))set(false);});
    }
  })();
  // scroll reveal, fail-open
  const risers = [...document.querySelectorAll('.rise')];
  const io = new IntersectionObserver((es)=>es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target);}}),{rootMargin:'0px 0px -8% 0px',threshold:0.08});
  risers.forEach(el=>io.observe(el));
  setTimeout(()=>risers.forEach(el=>el.classList.add('in')),2500);

  // audit tool
  const form=document.getElementById('auditForm');
  const input=document.getElementById('url');
  const btn=document.getElementById('auditBtn');
  const hint=document.getElementById('hint');
  const report=document.getElementById('report');
  const rows=document.getElementById('rows');

  function normalize(u){u=u.trim();if(!u)return '';if(!/^https?:\/\//i.test(u))u='https://'+u;return u;}
  function icon(k){return k==='good'?'✓':k==='warn'?'~':'!';}
  function esc(s){return String(s==null?'':s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));}
  function lvlColor(k){return k==='good'?'var(--good)':k==='warn'?'var(--warn)':'var(--bad)';}

  function render(data){
    document.getElementById('rurl').textContent=data.url;
    const s=document.getElementById('score');
    s.textContent='Overall: '+data.score+' / 100';
    s.style.color=lvlColor(data.score>=80?'good':data.score>=50?'warn':'bad');

    // Category score bars
    document.getElementById('cats').innerHTML=(data.categories||[]).map(c=>{
      const v=c.score==null?'-':c.score;
      return `<div class="cat">
        <div class="cat-top"><span>${c.label}</span><b style="color:${lvlColor(c.level)}">${v}</b></div>
        <div class="bar"><div class="fill" style="width:${c.score==null?0:c.score}%;background:${lvlColor(c.level)}"></div></div>
      </div>`;
    }).join('');

    // Core Web Vitals (lab)
    const vw=document.getElementById('vitals');
    if((data.vitals||[]).length){
      vw.innerHTML=`<div class="sec-lbl">Core Web Vitals <span>(lab test)</span></div>
        <div class="vitals">`+data.vitals.map(v=>
        `<div class="vital"><div class="vdot" style="background:${lvlColor(v.level)}"></div>
          <div class="vval">${v.value||'-'}</div>
          <div class="vname">${v.name}</div>
          <div class="vhelp">${v.help}</div></div>`).join('')+`</div>`;
    } else vw.innerHTML='';

    // Real-user field data
    const fw=document.getElementById('field');
    if(data.hasField && (data.field||[]).length){
      fw.innerHTML=`<div class="sec-lbl">Real visitor experience <span>(Chrome user data, last 28 days)</span></div>
        <div class="field">`+data.field.map(f=>
        `<div class="fchip" style="border-color:${lvlColor(f.level)}">
          <span class="fdot" style="background:${lvlColor(f.level)}"></span>${f.name}: <b>${f.value}</b></div>`).join('')+`</div>`;
    } else fw.innerHTML='';

    // Fix opportunities
    const ow=document.getElementById('opps');
    if((data.opportunities||[]).length){
      ow.innerHTML=`<div class="sec-lbl">Biggest fixes available <span>(estimated gains)</span></div>`+
        data.opportunities.map(o=>
        `<div class="opp"><div class="opp-t">${o.title}</div><div class="opp-s">${o.savings}</div></div>`).join('');
    } else ow.innerHTML='';

    // Accessibility (axe-core via Lighthouse)
    const aw=document.getElementById('a11y');
    const asum=data.a11ySummary;
    if(asum){
      let html=`<div class="sec-lbl">Accessibility <span>(axe-core / WCAG checks)</span></div>`+
        `<div class="a11y-sum ${asum.level}"><div class="icn ${asum.level}">${icon(asum.level)}</div>`+
        `<div><h4>${esc(asum.title)}</h4><p>${esc(asum.detail)}</p></div></div>`;
      if((data.a11y||[]).length){
        html+=`<div class="a11y-list">`+data.a11y.map(a=>
          `<div class="a11y-item"><div class="a11y-dot"></div><div><b>${esc(a.title)}`+
          `${a.count?` <span class="a11y-n">(${a.count} spot${a.count>1?'s':''})</span>`:''}</b>`+
          `<span>${esc(a.detail)}</span></div></div>`).join('')+`</div>`;
      }
      aw.innerHTML=html;
    } else aw.innerHTML='';
    const stw=document.getElementById('stack');
    if((data.stack||[]).length){
      stw.innerHTML=`<div class="sec-lbl">Technology stack <span>(detected on the live page)</span></div>`+
        `<div class="stack">`+data.stack.map(t=>
        `<div class="tchip"><b>${esc(t.name)}</b><span>${esc(t.category)}</span></div>`).join('')+`</div>`;
    } else stw.innerHTML='';

    // Hosting / DNS
    const hw=document.getElementById('hosting');
    const hd=data.hosting;
    if(hd && (hd.ips||[]).length){
      const rows=[];
      if(hd.provider) rows.push(['Hosted on', esc(hd.provider)]);
      if(hd.network && hd.network!==hd.provider) rows.push(['Network', esc(hd.network)]);
      if(hd.country) rows.push(['Region', esc(hd.country)]);
      if((hd.cnames||[]).length) rows.push(['DNS points to', esc(hd.cnames.join(' → '))]);
      rows.push(['IP address', esc(hd.ips.slice(0,2).join(', '))]);
      hw.innerHTML=`<div class="sec-lbl">Hosting &amp; DNS <span>(where the site lives)</span></div>`+
        `<div class="host">`+rows.map(r=>
        `<div class="hrow"><span class="hk">${r[0]}</span><span class="hv">${r[1]}</span></div>`).join('')+`</div>`;
    } else hw.innerHTML='';
    document.getElementById('rows').innerHTML=(data.findings||[]).map(f=>
      `<div class="row"><div class="icn ${f.level}">${icon(f.level)}</div><div><h4>${f.title}</h4><p>${f.detail}</p></div></div>`
    ).join('');

    report.hidden=false;
    report.scrollIntoView({behavior:'smooth',block:'start'});
  }

  form.addEventListener('submit', async (e)=>{
    e.preventDefault();
    const url=normalize(input.value);
    if(!url){hint.textContent='Enter a website address first.';hint.classList.add('err');return;}
    hint.classList.remove('err');
    btn.disabled=true;const orig=btn.textContent;btn.innerHTML='<span class="spin"></span>Analyzing…';
    hint.textContent='Running a real performance check on Google\u2019s servers - this can take up to a minute…';
    const fetchAudit=async(ms)=>{
      const ctrl=new AbortController();const t=setTimeout(()=>ctrl.abort(),ms);
      try{return await fetch(`${base}/api/audit?url=`+encodeURIComponent(url),{signal:ctrl.signal});}
      finally{clearTimeout(t);}
    };
    try{
      let data,ok=false;
      for(let attempt=0;attempt<2 && !ok;attempt++){
        if(attempt) hint.textContent='The audit service was busy - retrying…';
        try{
          const res=await fetchAudit(75000);
          if(!res.ok) throw new Error('bad status '+res.status);
          data=await res.json();
          if(data.error) throw new Error(data.error);
          ok=true;
        }catch(e){ if(attempt===1) throw e; }
      }
      render(data);
      hint.textContent='Analysis of a live, third-party performance report.';
    }catch(err){
      hint.textContent="Google\u2019s free audit service is busy right now (it rate-limits heavy use). Give it a moment and try again - your site is fine.";
      hint.classList.add('err');
    }finally{
      btn.disabled=false;btn.textContent=orig;
    }
  });
</script>
