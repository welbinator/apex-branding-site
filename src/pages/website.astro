---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Layout
  title="A professional website for $49/mo — $0 down. | James Welbes"
  description="Small business? Get a fast, secure, professionally-built website with a contact form and unlimited minor updates for $49/month. No money down. Month-to-month. Cancel anytime.">
  <header>
    <div class="wrap nav">
      <a class="mark" href={base + '/'}>JAMES<span class="mk-thin">WELBES</span></a>
      <a href="#start" class="btn">Get started</a>
    </div>
  </header>

  <!-- HERO -->
  <section class="lp-hero">
    <div class="glow"></div>
    <div class="wrap">
      <div class="pill rise">No money down · $49/mo · Cancel anytime</div>
      <h1 class="rise">A website that wins you customers —<br><span class="hl">$0 down, $49 a month.</span></h1>
      <p class="lead rise">You run a real business. You should have a real website — not a DIY template you'll never finish, and not a $5,000 bill up front. I build it, host it, secure it, and keep it updated. You pay <b>nothing to start</b> and <b>$49/month</b> after. That's it.</p>
      <div class="hero-cta rise">
        <a href="#start" class="btn-accent">Claim my $49/mo website →</a>
        <a href="#how" class="btn-ghost">How it works</a>
      </div>
      <div class="trust rise">
        <span>✓ No money down</span>
        <span>✓ Month-to-month</span>
        <span>✓ Cancel anytime</span>
        <span>✓ Built by a real human</span>
      </div>
    </div>
  </section>

  <!-- PROBLEM -->
  <section class="lp-prob">
    <div class="wrap">
      <div class="k rise" style="color:#8fa4ff">The problem</div>
      <h2 class="rise">"I know I need a website. I just haven't done it."</h2>
      <div class="prob-grid">
        <div class="pcard rise"><div class="pemoji">💸</div><h3>The big quote scared you off</h3><p>Agencies want thousands up front before you've seen a thing. So you put it off. Again.</p></div>
        <div class="pcard rise"><div class="pemoji">🧩</div><h3>The DIY builder is still half-done</h3><p>You started a template six months ago. It's still sitting there, unfinished, embarrassing.</p></div>
        <div class="pcard rise"><div class="pemoji">👻</div><h3>Customers can't find you</h3><p>They Google your business, find nothing solid, and call the competitor who does have a real site.</p></div>
      </div>
    </div>
  </section>

  <!-- OFFER / WHAT YOU GET -->
  <section id="how" class="lp-offer">
    <div class="wrap">
      <div class="k rise" style="color:var(--accent)">The offer</div>
      <h2 class="rise">Everything handled. One flat $49 a month.</h2>
      <p class="lead rise offer-lead">No setup fee. No deposit. No surprise invoice. I build your site and keep it running — you just show up and run your business.</p>
      <div class="feat-grid">
        <div class="feat rise"><h3>A website built for you</h3><p>Professionally designed around your business — not a cookie-cutter template. Fast and clean on phones and desktop.</p></div>
        <div class="feat rise"><h3>A working contact form</h3><p>Visitors reach you straight from the site. Every inquiry lands in your inbox — no missed leads.</p></div>
        <div class="feat rise"><h3>Unlimited minor updates</h3><p>New hours, a photo, a price change, a paragraph? Send it over and I'll take care of it. No per-edit fees.</p></div>
        <div class="feat rise"><h3>Fast, reliable, secure hosting</h3><p>Enterprise-grade hosting with SSL security built in. It stays up, stays fast, and stays safe — I handle all of it.</p></div>
      </div>
    </div>
  </section>

  <!-- PRICE ANCHOR -->
  <section class="lp-price">
    <div class="wrap">
      <div class="price-card rise">
        <div class="pc-top">The whole thing</div>
        <div class="pc-amt"><span class="pc-dollar">$</span>49<span class="pc-per">/month</span></div>
        <div class="pc-sub">$0 down · month-to-month · cancel anytime</div>
        <ul class="pc-list">
          <li>Custom-built website</li>
          <li>Contact form</li>
          <li>Unlimited minor updates</li>
          <li>Fast, secure, reliable hosting + SSL</li>
          <li>Built and maintained by a real person</li>
        </ul>
        <a href="#start" class="btn-accent pc-cta">Get started — $0 today →</a>
        <div class="pc-fine">You pay nothing to begin. Your first $49 isn't charged until your site is live and you're happy with it.</div>
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section class="lp-steps">
    <div class="wrap">
      <div class="k rise">How it works</div>
      <h2 class="rise">Live in days, not months.</h2>
      <div class="steps3">
        <div class="step rise"><div class="snum">1</div><h3>Tell me about your business</h3><p>Fill out the short form below. Takes two minutes — no payment, no commitment.</p></div>
        <div class="step rise"><div class="snum">2</div><h3>I build your site</h3><p>I design and build it, then show you. We fine-tune it until it's right. Still $0 so far.</p></div>
        <div class="step rise"><div class="snum">3</div><h3>Go live for $49/mo</h3><p>Happy with it? It goes live and your $49/month begins. Cancel anytime, no hard feelings.</p></div>
      </div>
    </div>
  </section>

  <!-- FORM -->
  <section id="start" class="lp-form">
    <div class="wrap">
      <div class="k rise" style="color:var(--accent)">Start free</div>
      <h2 class="rise">Claim your $49/mo website</h2>
      <p class="lead rise form-lead">Two minutes, no payment, no obligation. Tell me about your business and I'll be in touch to get started.</p>

      <form id="leadForm" class="lead-form rise" novalidate>
        <div class="lf-row">
          <div class="lf-field">
            <label for="lf-name">Your name *</label>
            <input id="lf-name" name="name" type="text" autocomplete="name" required />
          </div>
          <div class="lf-field">
            <label for="lf-email">Email *</label>
            <input id="lf-email" name="email" type="email" autocomplete="email" required />
          </div>
        </div>
        <div class="lf-row">
          <div class="lf-field">
            <label for="lf-business">Business name</label>
            <input id="lf-business" name="business" type="text" autocomplete="organization" />
          </div>
          <div class="lf-field">
            <label for="lf-phone">Phone (optional)</label>
            <input id="lf-phone" name="phone" type="tel" autocomplete="tel" />
          </div>
        </div>
        <div class="lf-field">
          <label for="lf-message">Anything you want me to know? (optional)</label>
          <textarea id="lf-message" name="message" rows="3" placeholder="What does your business do? Do you have a site now?"></textarea>
        </div>
        <!-- honeypot: hidden from humans -->
        <div class="hp" aria-hidden="true"><label>Website<input name="website_hp" tabindex="-1" autocomplete="off" /></label></div>
        <button type="submit" id="lfBtn" class="btn-accent lf-submit">Get my website started →</button>
        <div class="lf-hint" id="lfHint">$0 today. No obligation. I usually reply within a day.</div>
      </form>

      <div id="lfDone" class="lf-done" hidden>
        <div class="lf-check">✓</div>
        <h3>You're in — thank you!</h3>
        <p>I've got your details and I'll be in touch shortly to get your website started. No payment was taken.</p>
      </div>
    </div>
  </section>

  <footer>
    <div class="wrap ffx">
      <div><strong>James Welbes</strong> · Websites for small business</div>
      <div>Cedar Rapids, Iowa · $49/mo · No money down</div>
    </div>
  </footer>
</Layout>

<style is:global>
  :root{ --bg:#0b0d12; --bg2:#111520; --card:#151a26; --line2:#232a3a; --txt:#eef1f6; --mut:#9aa4b6; }
  body{background:var(--bg);color:var(--txt)}
  ::selection{background:var(--accent);color:#fff}

  header{border-bottom:1px solid var(--line2);position:sticky;top:0;background:rgba(11,13,18,.82);backdrop-filter:blur(10px);z-index:30}
  .nav{display:flex;align-items:center;justify-content:space-between;height:68px}
  .mark{font-weight:700;font-size:18px;text-decoration:none;letter-spacing:-.02em;color:var(--txt)}
  .mark .mk-thin{font-weight:400;opacity:.6}
  .btn{background:#fff;color:var(--bg)!important;padding:9px 17px;border-radius:3px;font-weight:600;text-decoration:none;font-size:14px}
  .btn:hover{background:var(--accent);color:#fff!important}
  .hl{color:var(--accent);text-shadow:0 0 34px rgba(26,79,255,.5)}

  .wrap{max-width:1120px;margin:0 auto;padding:0 24px}
  section{padding:84px 0}
  .k{font-size:12px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--mut)}
  h2{font-size:38px;font-weight:700;margin:12px 0 22px;max-width:720px;letter-spacing:-.03em;line-height:1.1}
  .lead{font-size:18px;color:var(--mut);line-height:1.6;max-width:620px}
  .btn-accent{display:inline-block;background:var(--accent);color:#fff!important;text-decoration:none;font-weight:600;font-size:15px;padding:13px 26px;border-radius:6px;box-shadow:0 10px 28px rgba(26,79,255,.32);border:none;cursor:pointer;font-family:var(--font-body)}
  .btn-accent:hover{filter:brightness(1.12)}
  .btn-ghost{display:inline-block;border:1px solid var(--line2);color:var(--txt)!important;text-decoration:none;font-weight:600;font-size:15px;padding:12px 24px;border-radius:6px}
  .btn-ghost:hover{border-color:var(--accent);color:#fff!important}

  /* HERO */
  .lp-hero{position:relative;padding:80px 0 70px;overflow:hidden;text-align:center;border-bottom:1px solid var(--line2)}
  .glow{position:absolute;top:-180px;left:50%;transform:translateX(-50%);width:820px;height:620px;background:radial-gradient(circle,rgba(26,79,255,.26),transparent 62%);filter:blur(20px);pointer-events:none;z-index:0}
  .lp-hero .wrap{position:relative;z-index:1}
  .pill{display:inline-block;font-size:13px;font-weight:700;letter-spacing:.04em;color:var(--accent);background:rgba(26,79,255,.12);border:1px solid rgba(26,79,255,.4);padding:7px 16px;border-radius:30px;margin-bottom:22px}
  .lp-hero h1{font-size:56px;line-height:1.04;font-weight:700;letter-spacing:-.035em;margin-bottom:22px}
  .lp-hero .lead{margin:0 auto 30px}
  .hero-cta{display:flex;gap:12px;justify-content:center;flex-wrap:wrap;margin-bottom:30px}
  .trust{display:flex;gap:22px;justify-content:center;flex-wrap:wrap;font-size:14px;color:var(--mut);font-weight:500}
  .trust span{white-space:nowrap}

  /* PROBLEM */
  .lp-prob{border-bottom:1px solid var(--line2)}
  .prob-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
  .pcard{background:var(--card);border:1px solid var(--line2);border-radius:12px;padding:26px}
  .pemoji{font-size:26px;margin-bottom:14px}
  .pcard h3{font-size:18px;margin-bottom:9px}
  .pcard p{font-size:14.5px;color:var(--mut);line-height:1.6}

  /* OFFER */
  .lp-offer{border-bottom:1px solid var(--line2)}
  .offer-lead{margin-bottom:36px}
  .feat-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}
  .feat{background:var(--card);border:1px solid var(--line2);border-radius:12px;padding:26px}
  .feat h3{font-size:18px;margin-bottom:7px}
  .feat p{font-size:14.5px;color:var(--mut);line-height:1.6}

  /* PRICE CARD */
  .lp-price{background:linear-gradient(180deg,var(--bg2),var(--bg));border-bottom:1px solid var(--line2)}
  .price-card{max-width:440px;margin:0 auto;background:var(--card);border:1px solid rgba(26,79,255,.55);border-radius:18px;padding:38px 32px;text-align:center;box-shadow:0 0 0 1px rgba(26,79,255,.3),0 30px 70px rgba(26,79,255,.14)}
  .pc-top{font-size:13px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--mut)}
  .pc-amt{font-family:var(--font-display);font-size:74px;font-weight:700;line-height:1;margin:10px 0 6px;letter-spacing:-.04em}
  .pc-dollar{font-size:38px;vertical-align:super;color:var(--accent)}
  .pc-per{font-size:22px;color:var(--mut);font-weight:500}
  .pc-sub{font-size:14px;color:var(--accent);font-weight:600;margin-bottom:22px}
  .pc-list{list-style:none;text-align:left;display:grid;gap:11px;margin:0 auto 26px;max-width:280px}
  .pc-list li{font-size:15px;padding-left:26px;position:relative;color:var(--txt)}
  .pc-list li:before{content:"✓";position:absolute;left:0;color:var(--accent);font-weight:800}
  .pc-cta{width:100%;box-sizing:border-box}
  .pc-fine{font-size:12.5px;color:var(--mut);margin-top:16px;line-height:1.5}

  /* STEPS */
  .lp-steps{border-bottom:1px solid var(--line2)}
  .steps3{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
  .step{background:var(--card);border:1px solid var(--line2);border-radius:12px;padding:28px}
  .snum{width:38px;height:38px;border-radius:50%;background:rgba(26,79,255,.14);border:1px solid rgba(26,79,255,.5);color:var(--accent);font-family:var(--font-display);font-weight:700;font-size:18px;display:flex;align-items:center;justify-content:center;margin-bottom:16px}
  .step h3{font-size:18px;margin-bottom:9px}
  .step p{font-size:14.5px;color:var(--mut);line-height:1.6}

  /* FORM */
  .form-lead{margin-bottom:30px}
  .lead-form{max-width:620px;background:var(--card);border:1px solid var(--line2);border-radius:14px;padding:28px;box-shadow:0 20px 50px rgba(0,0,0,.4)}
  .lf-row{display:grid;grid-template-columns:1fr 1fr;gap:16px}
  .lf-field{margin-bottom:16px;display:flex;flex-direction:column}
  .lf-field label{font-size:13px;font-weight:600;margin-bottom:6px;color:var(--txt)}
  .lf-field input,.lf-field textarea{background:var(--bg);border:1px solid var(--line2);border-radius:7px;padding:12px 13px;color:var(--txt);font-size:15px;font-family:var(--font-body);outline:none}
  .lf-field input:focus,.lf-field textarea:focus{border-color:var(--accent)}
  .lf-field textarea{resize:vertical}
  .hp{position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden}
  .lf-submit{width:100%;margin-top:4px}
  .lf-submit:disabled{opacity:.7;cursor:wait}
  .lf-spin{display:inline-block;width:15px;height:15px;border:2px solid rgba(255,255,255,.35);border-top-color:#fff;border-radius:50%;animation:spin .7s linear infinite;vertical-align:-2px;margin-right:8px}
  @keyframes spin{to{transform:rotate(360deg)}}
  .lf-hint{font-size:13px;color:var(--mut);margin-top:14px;text-align:center}
  .lf-hint.err{color:#ff9b9b}
  .lf-done{max-width:620px;background:linear-gradient(180deg,rgba(26,79,255,.1),var(--card));border:1px solid rgba(26,79,255,.45);border-radius:14px;padding:40px 28px;text-align:center}
  .lf-check{width:56px;height:56px;border-radius:50%;background:var(--accent);color:#fff;font-size:28px;font-weight:800;display:flex;align-items:center;justify-content:center;margin:0 auto 18px}
  .lf-done h3{font-size:24px;margin-bottom:10px}
  .lf-done p{font-size:16px;color:var(--mut);max-width:440px;margin:0 auto;line-height:1.6}

  footer{border-top:1px solid var(--line2);padding:38px 0;font-size:13px;color:var(--mut)}
  .ffx{display:flex;justify-content:space-between;flex-wrap:wrap;gap:14px}
  footer strong{color:var(--txt)}

  /* reveal */
  .js .rise{opacity:0;transform:translateY(16px);transition:opacity .6s ease,transform .6s ease}
  .js .rise.in{opacity:1;transform:none}

  @media(max-width:820px){
    .lp-hero h1{font-size:40px}
    h2{font-size:30px}
    .prob-grid,.feat-grid,.steps3,.lf-row{grid-template-columns:1fr}
    .trust{gap:14px;font-size:13px}
  }
</style>

<script define:vars={{ base }}>
  document.documentElement.classList.add('js');
  const risers=[...document.querySelectorAll('.rise')];
  const io=new IntersectionObserver((es)=>es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target);}}),{rootMargin:'0px 0px -6% 0px',threshold:0.06});
  risers.forEach(el=>io.observe(el));
  setTimeout(()=>risers.forEach(el=>el.classList.add('in')),2500);

  const form=document.getElementById('leadForm');
  const btn=document.getElementById('lfBtn');
  const hint=document.getElementById('lfHint');
  const done=document.getElementById('lfDone');

  function splitName(full){
    const p=full.trim().split(/\s+/);
    return { first: p[0]||'', last: p.slice(1).join(' ')||'' };
  }

  form.addEventListener('submit', async (e)=>{
    e.preventDefault();
    hint.classList.remove('err');
    const name=form.name.value.trim();
    const email=form.email.value.trim();
    if(!name){hint.textContent='Please enter your name.';hint.classList.add('err');return;}
    if(!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)){hint.textContent='Please enter a valid email.';hint.classList.add('err');return;}
    const {first,last}=splitName(name);
    const payload={
      first_name:first, last_name:last, email,
      business:form.business.value.trim(),
      phone:form.phone.value.trim(),
      message:form.message.value.trim(),
      website_hp:form.website_hp.value,
      form_name:'website-offer-49'
    };
    btn.disabled=true;const orig=btn.textContent;btn.innerHTML='<span class="lf-spin"></span>Sending…';
    hint.textContent='One moment…';
    try{
      const res=await fetch(`${base}/api/lead`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload)});
      const data=await res.json().catch(()=>({}));
      if(!res.ok||!data.ok) throw new Error(data.error||'failed');
      form.hidden=true; done.hidden=false;
      done.scrollIntoView({behavior:'smooth',block:'center'});
    }catch(err){
      hint.textContent=(err.message&&err.message!=='failed')?err.message:"Something went wrong sending that. Please try again, or email james@apexbranding.design.";
      hint.classList.add('err');
      btn.disabled=false;btn.textContent=orig;
    }
  });
</script>
